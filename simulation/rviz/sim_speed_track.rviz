Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Queue Size: 10
    - Class: rviz/Odometry
      Enabled: true
      Name: Odometry
      Topic: /odom
      Color: 160; 160; 160
    - Class: rviz/Path
      Enabled: true
      Name: Path
      Topic: /path
      Color: 255; 0; 0
    - Class: rviz/Camera
      Enabled: false
      Name: Camera
      Topic: /csi_cam_0/image_raw
  Global Options:
    Fixed Frame: odom
  Name: root
  Tools:
    - Class: rviz/Interact
      Name: Interact
    - Class: rviz/MoveCamera
      Name: Move Camera
