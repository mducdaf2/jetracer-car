<launch>
  <param name="/use_sim_time" value="false" />
  <rosparam command="load" file="$(find jetracer)/simulation/config/simulation_params.yaml" />

  <node pkg="jetracer" type="sim_serial_mock.py" name="serial_mock" output="screen" />
  <node pkg="jetracer" type="sim_odometry_publisher.py" name="simulation_odometry" output="screen" />

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find jetracer)/simulation/rviz/sim_speed_track.rviz" output="screen" />
</launch>
